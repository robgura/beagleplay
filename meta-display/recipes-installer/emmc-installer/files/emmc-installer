#!/bin/bash

set -e

if [ "$1" != "y" ]
then
    # hack to stop service from doing anything, requires a manual run
    exit 0
fi

echo H > /tmp/led_state
# /opt/emmc-installer/led-control.sh &

IMAGE_FILE=/display-image-emmc.wic.xz
EMMC_DEVICE=/dev/mmcblk0
BOOT_PARTITION=p1
EMMC_BOOT_PARTITION=${EMMC_DEVICE}${BOOT_PARTITION}
SD_DEVICE=/dev/mmcblk1
SD_BOOT_PARTITION=${SD_DEVICE}${BOOT_PARTITION}

mounted_emmc_boot_dir=/mnt/emmc_boot
mounted_sd_boot_dir=/mnt/sd_boot

EMMC_BS=1M
EMMC_ERASE_SIZE=128

echo erasing start of ${EMMC_DEVICE}
dd if=/dev/zero of=${EMMC_DEVICE} bs=${EMMC_BS} count=${EMMC_ERASE_SIZE} 2> /dev/null

echo bmap image ${IMAGE_FILE} to ${EMMC_DEVICE}
bmaptool copy ${IMAGE_FILE} ${EMMC_DEVICE}

echo I > /tmp/led_state

mkdir -p ${mounted_emmc_boot_dir}
mount ${EMMC_BOOT_PARTITION} ${mounted_emmc_boot_dir}

bin_file=${mounted_emmc_boot_dir}/tiboot3.bin

# https://docs.beagleboard.org/latest/boards/beagleplay/demos-and-tutorials/understanding-boot.html
mmc bootpart enable 1 2 ${EMMC_DEVICE}
mmc bootbus set single_backward x1 x8 ${EMMC_DEVICE}
set +e
mmc hwreset enable ${EMMC_DEVICE}
set -e

echo Clearing eMMC boot0
echo '0' >> /sys/class/block/mmcblk0boot0/force_ro
dd if=/dev/zero of=${EMMC_DEVICE}boot0 count=32 bs=128k
echo Using dd to write ${bin_file} to ${EMMC_DEVICE}boot0
dd if=${bin_file} of=${EMMC_DEVICE}boot0 bs=128k

echo I > /tmp/led_state
echo writing to file ${mounted_emmc_boot_dir}/extlinux/extlinux.conf

cat <<HeRe > ${mounted_emmc_boot_dir}/extlinux/extlinux.conf
# Generic Distro Configuration file generated by OpenEmbedded
LABEL display-distro
        KERNEL ../Image
        FDTDIR ../
        APPEND root=/dev/mmcblk0p2 rootwait rootfstype=ext4
HeRe

### mkdir -p ${mounted_sd_boot_dir}
### mount ${SD_BOOT_PARTITION} ${mounted_sd_boot_dir}
### # HACK not sure why this file is not created as part of the display-image
### #      but using it the sd card version seems to work fine
### cp ${mounted_sd_boot_dir}/Image ${mounted_emmc_boot_dir}/Image

touch ${mounted_emmc_boot_dir}/done
umount ${EMMC_BOOT_PARTITION}
umount ${SD_BOOT_PARTITION}

echo C > /tmp/led_state
echo Done
