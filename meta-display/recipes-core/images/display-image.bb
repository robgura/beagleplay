IMAGE_INSTALL:append = " gawk"
IMAGE_INSTALL:append = " git"
IMAGE_INSTALL:append = " grep"
IMAGE_INSTALL:append = " mmc-utils"
IMAGE_INSTALL:append = " mesa"
IMAGE_INSTALL:append = " mesa-demos"
IMAGE_INSTALL:append = " networkmanager"
